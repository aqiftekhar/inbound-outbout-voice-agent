# --- Outbound calling (for trigger_call.py) ---
# Required only if you want trigger_call.py to actually dial a real/test
# phone number via SIP. Follow the same trunk-setup pattern as the sibling
# Almosafer project's setup_outbound_trunk.py, but you'll need a trunk
# capable of *outbound* dialing to arbitrary numbers, not just the fixed
# operator extension used there.
OUTBOUND_TRUNK_ID=ST_VjWrogpiuQrS
OUTBOUND_TRUNK_NUMBER=8844056

# --- Optional real human-transfer target (leave blank for demo-mode
# simulated transfer, which just ends the call and logs human_transfer=true) ---
