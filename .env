# --- LiveKit ---
LIVEKIT_URL=ws://XX.X.X.XXX:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT / LLM / TTS ---
DEEPGRAM_API_KEY=
# GROQ_API_KEY=

# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
GROQ_API_KEY=ollama-local-no-auth-required

STT_MODEL=nova-3
STT_LANGUAGE=ar

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_TTS_MODEL=

# --- Outbound calling (for trigger_call.py) ---
# Required only if you want trigger_call.py to actually dial a real/test
# phone number via SIP. Follow the same trunk-setup pattern as the sibling
# Almosafer project's setup_outbound_trunk.py, but you'll need a trunk
# capable of *outbound* dialing to arbitrary numbers, not just the fixed
# operator extension used there.
OUTBOUND_TRUNK_ID=ST_VjWrogpiuQrS
OUTBOUND_TRUNK_NUMBER=XXXXXXX

# --- Optional real human-transfer target (leave blank for demo-mode
# simulated transfer, which just ends the call and logs human_transfer=true) ---
FREEPBX_HOST=XX.X.X.XXX
SIP_TRANSFER_EXTENSION=80

# --- Agent identity ---
AGENT_NAME=ai-medical

# --- Guardrails ---
MAX_CALL_DURATION_SECONDS=600
DTMF_DEBOUNCE_SECONDS=0.3
MAX_VERIFY_ATTEMPTS=2
SILENCE_REPROMPT_SECONDS=8
MAX_SILENCE_REPROMPTS=2

# --- VAD tuning ---
VAD_MIN_SPEECH_DURATION=0.1
VAD_MIN_SILENCE_DURATION=0.8
VAD_PREFIX_PADDING_DURATION=0.5
VAD_ACTIVATION_THRESHOLD=0.5

# --- Endpointing ---
MIN_ENDPOINTING_DELAY=0.6
MAX_ENDPOINTING_DELAY=6.0
