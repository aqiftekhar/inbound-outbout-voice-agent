# --- LiveKit ---
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT / LLM / TTS ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=nova-3
STT_LANGUAGE=ar

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# --- Outbound calling (for trigger_call.py) ---
OUTBOUND_TRUNK_ID=
# The provider-facing DID this trunk uses (NOT an internal extension like
# SIP_TRANSFER_EXTENSION=80) - LiveKit rejects trunk creation without at
# least one number here (confirmed by hitting that error directly).
OUTBOUND_TRUNK_NUMBER=8844056

# --- Optional real human-transfer target (leave blank for demo-mode
# simulated transfer, which just ends the call and logs human_transfer=true) ---
FREEPBX_HOST=
SIP_TRANSFER_EXTENSION=80

# --- Agent identity ---
AGENT_NAME=ai-medical

# --- Guardrails ---
MAX_CALL_DURATION_SECONDS=600
DTMF_DEBOUNCE_SECONDS=0.3
MAX_VERIFY_ATTEMPTS=2
SILENCE_REPROMPT_SECONDS=8
MAX_SILENCE_REPROMPTS=2

# --- VAD tuning ---
VAD_MIN_SPEECH_DURATION=0.1
VAD_MIN_SILENCE_DURATION=0.8
VAD_PREFIX_PADDING_DURATION=0.5
VAD_ACTIVATION_THRESHOLD=0.5

# --- Endpointing ---
MIN_ENDPOINTING_DELAY=0.6
MAX_ENDPOINTING_DELAY=6.0

# --- Interruption/barge-in tuning ---
INTERRUPTION_MIN_DURATION=0.2
INTERRUPTION_MIN_WORDS=0
